# Gemini API key. client.ts reads GEMINI_API_KEY, then GOOGLE_API_KEY, then API_KEY (first one set wins).
GEMINI_API_KEY=

# Optional: only used if it starts with "gemini-", otherwise falls back to gemini-2.5-flash.
MODEL=

# Optional: restrict which absolute "folder" paths the MCP server will touch.
# List of absolute paths, delimited by ; on Windows or : on Unix (path.delimiter).
# Unset accepts any absolute folder — fine for the demo, set this before pointing at real data.
ALLOWED_ROOTS=